# Re-resolve the backend's internal hostname on this short a TTL instead of
# caching it for the life of the nginx process - see start.sh for why.
resolver ${DNS_RESOLVER} valid=10s;

server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Redirect non-www to www (only in production)
    if ($host = 'adajoon.com') {
        return 301 https://www.adajoon.com$request_uri;
    }

    # Security headers
    add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        # A literal proxy_pass target (no nginx variable involved) is
        # resolved once, at config-load time, and then nginx never looks it
        # up again no matter what the `resolver` directive or its TTL says -
        # that static resolution is what let this proxy keep talking to a
        # backend container Railway had already replaced. Putting the target
        # in a variable forces a fresh DNS lookup through `resolver` on
        # each new upstream connection instead.
        # Note: with a variable in proxy_pass, nginx does NOT do its usual
        # location-prefix-for-proxy_pass-URI substitution (confirmed by
        # testing this change against a live nginx instance) - the request's
        # own URI has to be forwarded explicitly via $request_uri instead,
        # or every request would reach the backend as a bare "/api/".
        set $backend_upstream ${BACKEND_URL};
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 16k;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        # Ensure index.html fallback is never cached (try_files serves from this location context)
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Cross-Origin-Embedder-Policy "unsafe-none" always;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
}
