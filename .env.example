# Environment
ENV=production

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SYNC_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (required for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# JWT Secret (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secure-secret-here-minimum-32-characters

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=your.apple.service.id

# WebAuthn (Passkeys)
WEBAUTHN_RP_ID=yourdomain.com
WEBAUTHN_RP_NAME=Adajoon
WEBAUTHN_ORIGIN=https://yourdomain.com

# API Keys
SYNC_API_KEY=your-sync-api-key

# No app secret (TMDB_API_KEY, STRIPE_*, SYNC_API_KEY, etc.) belongs in a
# local .env - they all live in RevestTech/revest-vault (see Admin ->
# Secrets, or vault-api directly). For local Docker dev, run the stack via
# `railway run -- docker compose -p adajoon up -d` (after `railway link` to
# the Adajoon project) so VAULT_ADDR/VAULT_ROLE_ID/VAULT_SECRET_ID come
# from the backend service's already-enrolled AppRole variables instead of
# being written to disk here.

# Stripe (for subscriptions)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Analytics is self-hosted (own Postgres, no third-party service) - see
# docs/CUSTOM_ANALYTICS.md. No env vars needed for it.

# Error tracking (optional - unset disables it, see backend/app/main.py
# and frontend/src/sentry.js). Free tier: https://sentry.io
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# External APIs
IPTV_API_BASE=https://iptv-org.github.io/api
RADIO_BROWSER_API=https://de1.api.radio-browser.info

# CORS Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://adajoon.com,https://www.adajoon.com
